{
  "name": "reviewforge",
  "version": "1.0.0",
  "description": "Self-hosted AI pull request reviewer, AST semantic diff auditor, and automated unit test synthesizer",
  "main": "dist/index.js",
  "bin": {
    "reviewforge": "./bin/reviewforge.js"
  },
  "scripts": {
    "build": "tsc && npm run build:web",
    "build:server": "tsc",
    "build:web": "npm --prefix web run build",
    "start": "node dist/cli.js serve",
    "dev": "tsx src/cli.ts serve",
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandrmotologa/reviewforge.git"
  },
  "keywords": [
    "code-review",
    "ai-code-review",
    "static-analysis",
    "security-audit",
    "owasp-top-10",
    "ast",
    "git-diff",
    "github-actions",
    "webhooks",
    "test-synthesis",
    "semantic-analysis",
    "typescript",
    "nodejs",
    "fastify",
    "react19"
  ],
  "author": "Alexandr Motologa",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/alexandrmotologa/reviewforge/issues"
  },
  "homepage": "https://github.com/alexandrmotologa/reviewforge#readme",
  "dependencies": {
    "@babel/parser": "^7.26.9",
    "@babel/traverse": "^7.26.9",
    "@babel/types": "^7.26.9",
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.1.1",
    "@octokit/rest": "^21.1.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "recast": "^0.23.9",
    "yaml": "^2.9.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
